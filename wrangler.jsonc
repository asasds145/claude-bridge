{
  // Replace the placeholders below before deploying. Secrets go in via `wrangler secret put`, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chief-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "QUEUE", "class_name": "BoxmcpQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoxmcpQueue"] }],
  "kv_namespaces": [
    // `npx wrangler kv namespace create OAUTH_KV` and paste the id here
    { "binding": "OAUTH_KV", "id": "<YOUR_KV_NAMESPACE_ID>" }
  ],
  // IP ceiling in front of /mcp and POST /oauth/register. Takes effect on the next deploy.
  // namespace_id is an app-chosen positive integer with no other meaning. It is not an account id.
  // Bindings that share a namespace_id share counters across every Worker in the account, so this
  // value must be unique among Workers in the account.
  // 600/min is 30x the owner's 20/min cap. https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  "ratelimits": [
    {
      "name": "MCP_IP_LIMITER",
      "namespace_id": "7391846250",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "vars": {
    // Numeric GitHub user id of the only account allowed to authorize (https://api.github.com/users/<login> -> "id")
    "BOXMCP_OWNER_GITHUB_ID": "0",
    // Client ID of your GitHub OAuth app (callback URL: https://<your-worker-host>/callback)
    "GITHUB_CLIENT_ID": "",
    "CHIEF_WEBHOOK_AUTH_HEADER": "Authorization",
    "CHIEF_WEBHOOK_AUTH_SCHEME": "Bearer",
    // Public https origin of the worker, e.g. https://chief-bridge.<your-subdomain>.workers.dev
    // Empty = use the request origin.
    "BOXMCP_PUBLIC_ORIGIN": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    // Real wrangler key: strips query strings from request URLs in logs and traces.
    "redact_query_string": true
  }
  // secrets (wrangler secret put):
  // GITHUB_CLIENT_SECRET, CHIEF_WEBHOOK_URL, CHIEF_WEBHOOK_KEY, BOXMCP_CHIEF_API_KEY, BOXMCP_CHIEF_API_KEY_NEXT
}
